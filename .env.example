# ---------------------------------------------------------------------------
# Copy to .env and fill in. The backend reads this file at boot and validates it
# with zod (backend/src/env.ts) — it will refuse to start on anything invalid.
#
# SECURITY: this app has no authentication. Anyone who can reach the port is
# the user. Bind it to localhost and reach it over a tunnel/VPN, or put a
# reverse proxy with basic-auth in front. Never expose it to the internet.
# ---------------------------------------------------------------------------

# NODE_ENV and LOG_LEVEL are deliberately absent. This file is loaded with
# `override: true` (see backend/src/env.ts), so anything listed here wins over
# the ambient environment — which is what stops a stale DATABASE_URL exported
# in your shell from silently redirecting migrations at another project's
# database. The flip side is that anything listed here also overrides what a
# test runner or process manager sets, so those two stay out of it.

PORT=3001
HOST=127.0.0.1

# Postgres. Matches docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgres://domaincheck:domaincheck@localhost:5433/domaincheck

# Separate database used by the integration tests. They TRUNCATE tables, so it
# must not point at your real data.
TEST_DATABASE_URL=postgres://domaincheck:domaincheck@localhost:5433/domaincheck_test

# --- IONOS -----------------------------------------------------------------
# Create a key at https://developer.hosting.ionos.com — the value has the shape
# "<publicprefix>.<secret>" and is sent verbatim as the X-Api-Key header.
IONOS_API_KEY=
# Only needed if your account requires an explicit tenant (X-Tenant-Id header).
IONOS_TENANT_ID=
IONOS_BASE_URL=https://api.hosting.ionos.com/domains
# Concurrent per-domain detail requests during a full sync.
IONOS_CONCURRENCY=4

# Set to 1 to run against local fixtures instead of the real IONOS API.
# Everything above the registrar adapter (sync, costs, alerts, the whole UI)
# behaves identically, so this is the normal development loop.
MOCK_REGISTRAR=1
# Optional fault injection for the mock adapter: 429 | 401 | partial | slow
MOCK_FAILURE_MODE=

# Dump raw registrar requests/responses (API key redacted) to logs/.
DEBUG_REGISTRAR=0

# --- Alerts (Resend) -------------------------------------------------------
# Leave RESEND_API_KEY empty to use the console transport: the digest is
# rendered and logged instead of sent, so alert logic is fully testable offline.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
