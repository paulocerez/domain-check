# drizzle-orm declares an optional peer on @op-engineering/op-sqlite, which pulls
# react-native (React 19) into the tree and conflicts with the client's React 18.
# Strict peer resolution reacts by isolating drizzle-orm under server/node_modules,
# where the hoisted drizzle-kit binary can no longer resolve it ("Please install
# latest version of drizzle-orm"). None of those React Native packages are ever
# installed or imported here — we only use drizzle-orm/node-postgres.
legacy-peer-deps=true
