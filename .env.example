# ---------------------------------------------------------------------------
# Copy to .env and fill in. The backend reads this file at boot and validates it
# with zod (backend/src/env.ts) — it will refuse to start on anything invalid.
#
# SECURITY: this app has no authentication. Anyone who can reach the port is
# the user. Bind it to localhost and reach it over a tunnel/VPN, or put a
# reverse proxy with basic-auth in front. Never expose it to the internet.
# ---------------------------------------------------------------------------

# NODE_ENV and LOG_LEVEL are deliberately absent. This file is loaded with
# `override: true` (see backend/src/env.ts), so anything listed here wins over
# the ambient environment — which is what stops a stale DATABASE_URL exported
# in your shell from silently redirecting migrations at another project's
# database. The flip side is that anything listed here also overrides what a
# test runner or process manager sets, so those two stay out of it.

PORT=3001
HOST=127.0.0.1

# Origins allowed to call the API from a browser, comma-separated. Leave empty
# when the backend serves the frontend itself (same-origin, no CORS involved).
# Set it only for a split deployment — e.g. the frontend on Vercel and the API
# reached over a tailnet:
#   CORS_ORIGINS=https://domain-check.vercel.app
# Never a wildcard: every response here carries the whole portfolio.
CORS_ORIGINS=

# Shared secret for GET /api/cron/sync, the scheduled sync used when the
# platform's cron is an HTTP call rather than an in-process timer (Vercel Cron
# sends it as `Authorization: Bearer $CRON_SECRET`). Unset, that endpoint
# refuses with 503 rather than running unauthenticated.
CRON_SECRET=

# Postgres. Matches docker-compose.yml (`npm run db:up`).
DATABASE_URL=postgres://domaincheck:domaincheck@localhost:5433/domaincheck

# For a hosted database, put the URL here or in .env.local (loaded after this
# file and allowed to win, so a provider CLI can write it without a manual
# merge).
#
# IMPORTANT: use a SESSION-mode / direct endpoint, not a transaction pooler.
# Managed providers usually front Postgres with PgBouncer and offer both. In
# transaction pooling mode a client is not kept on one server connection
# between statements, so session-level advisory locks stop excluding anything —
# verified live: two clients both acquired the same lock through a pooler.
# Sync mutual exclusion depends on that lock, so a pooled URL lets two syncs
# reconcile the same account at once, with no error and wrong results.
#
# If your provider exposes the direct endpoint under a separate name, set it
# here and the app will prefer it over DATABASE_URL.
# DATABASE_URL_UNPOOLED=

# Separate database used by the integration tests. They TRUNCATE tables, so it
# must not point at your real data.
TEST_DATABASE_URL=postgres://domaincheck:domaincheck@localhost:5433/domaincheck_test

# --- IONOS -----------------------------------------------------------------
# Create a key at https://developer.hosting.ionos.com — the value has the shape
# "<publicprefix>.<secret>" and is sent verbatim as the X-Api-Key header.
IONOS_API_KEY=
# Only needed if your account requires an explicit tenant (X-Tenant-Id header).
IONOS_TENANT_ID=
IONOS_BASE_URL=https://api.hosting.ionos.com/domains

# --- GoDaddy ---------------------------------------------------------------
# Create a key at https://developer.godaddy.com/keys. GoDaddy issues a *pair*,
# and both halves are secret — they are sent as "Authorization: sso-key
# <key>:<secret>". The account row stores only the name of the key variable;
# the secret is always read from GODADDY_API_SECRET.
#
# The GoDaddy account row is seeded only when GODADDY_API_KEY is set, so
# filling these in and re-running `npm run db:seed` is what adds the account.
#
# Heads up: GoDaddy restricts *production* API access to accounts holding 20+
# domains or a Discount Domain Club subscription. Without that, a production
# key answers 403 on /v1/domains. The OTE sandbox below is unrestricted, but
# issues its own separate key/secret and has its own test portfolio.
GODADDY_API_KEY=
GODADDY_API_SECRET=
# Only needed for a reseller acting on a subaccount (X-Shopper-Id header).
GODADDY_SHOPPER_ID=
# Sandbox: https://api.ote-godaddy.com
GODADDY_BASE_URL=https://api.godaddy.com

# --- Sync ------------------------------------------------------------------
# Concurrent per-domain detail requests during a full sync, for any registrar.
REGISTRAR_CONCURRENCY=4
# Deprecated alias for REGISTRAR_CONCURRENCY, still honoured as the fallback.
IONOS_CONCURRENCY=4

# Set to 1 to run against local fixtures instead of a real registrar API.
# Everything above the registrar adapter (sync, costs, alerts, availability,
# the whole UI) behaves identically, so this is the normal development loop.
MOCK_REGISTRAR=1
# Optional fault injection for the mock adapter: 429 | 401 | partial | slow
MOCK_FAILURE_MODE=

# Dump raw registrar requests/responses (API key redacted) to logs/.
DEBUG_REGISTRAR=0

# --- Alerts (Resend) -------------------------------------------------------
# Leave RESEND_API_KEY empty to use the console transport: the digest is
# rendered and logged instead of sent, so alert logic is fully testable offline.
RESEND_API_KEY=
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
